{
  "name": "vo-corpus",
  "private": true,
  "version": "0.0.0",
  "description": "Collects real VoiceOver speech through AT Driver to calibrate Rawstep's VoiceOver simulator (macOS only)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "generate": "tsx src/generate/index.ts",
    "probe": "tsx src/probe.ts",
    "collect": "tsx src/collect.ts",
    "replay": "tsx src/replay.ts",
    "compare": "tsx src/compare.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "rawstep": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.19.17",
    "playwright": "1.59.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
