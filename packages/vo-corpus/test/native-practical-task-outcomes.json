      "html": "<!doctype html><html lang=\"en\"><meta charset=\"utf-8\"><title>Community service desk</title><style>body{font:18px system-ui;padding:20px}label{display:block}button,input,summary{margin:8px}td,th{padding:12px}</style><body><button id=\"before\" autofocus>Before marker</button><article><h2>Basket review</h2><table><caption>Current basket</caption><tr><th>Item</th><th>Action</th></tr><tr><td>Canvas tote<input id=\"quantity\" aria-label=\"Basket quantity\" value=\"1\" readonly tabindex=\"-1\"></td><td><button id=\"add\">Add one tote</button><button id=\"remove\" disabled>Remove one tote</button></td></tr></table><button id=\"checkout\">Confirm basket</button><p id=\"receipt\" role=\"status\"></p></article><button id=\"after\">After marker</button><script>const byId=id=>document.getElementById(id);const update=delta=>{byId(\"quantity\").value=String(Number(byId(\"quantity\").value)+delta);byId(\"remove\").disabled=Number(byId(\"quantity\").value)<=1};byId(\"add\").onclick=()=>update(1);byId(\"remove\").onclick=()=>update(-1);byId(\"checkout\").onclick=()=>byId(\"receipt\").textContent=\"Order confirmed: \"+byId(\"quantity\").value+\" items\"</script></body></html>",
      "htmlSha256": "8cb04c5069da38c7b95f3ea0a003d8d65f46d7204a926a4673dd137c7495fdcc"
