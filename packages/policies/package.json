{
  "name": "@rawstep/policies",
  "private": true,
  "version": "0.2.0",
  "description": "Rawstep policies workspace",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./policy": {
      "types": "./dist/policy/index.d.ts",
      "import": "./dist/policy/index.js",
      "default": "./dist/policy/index.js"
    },
    "./package.json": "./package.json",
    "./llm": {
      "types": "./dist/llm/index.d.ts",
      "import": "./dist/llm/index.js",
      "default": "./dist/llm/index.js"
    },
    "./acp": {
      "types": "./dist/acp/index.d.ts",
      "import": "./dist/acp/index.js",
      "default": "./dist/acp/index.js"
    },
    "./llm/rules": {
      "types": "./dist/llm/rules.d.ts",
      "import": "./dist/llm/rules.js",
      "default": "./dist/llm/rules.js"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.63",
    "@rawstep/core": "workspace:*",
    "ai": "7.0.128",
    "zod": "4.6.5"
  }
}
