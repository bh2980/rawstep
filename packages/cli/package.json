{
  "name": "@rawstep/cli",
  "private": true,
  "version": "0.2.0",
  "description": "Rawstep command line: init, ui, run, hints, report, analyze and doctor",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "./dist/cli/bin.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./cli/args": {
      "types": "./dist/cli/args.d.ts",
      "import": "./dist/cli/args.js",
      "default": "./dist/cli/args.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js",
      "default": "./dist/cli/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@rawstep/core": "workspace:*",
    "@rawstep/browser": "workspace:*",
    "@rawstep/screenreaders": "workspace:*",
    "@rawstep/reports": "workspace:*",
    "@rawstep/project": "workspace:*",
    "@rawstep/dashboard": "workspace:*"
  },
  "peerDependencies": {
    "playwright": "^1.59.1"
  },
  "bin": {
    "rawstep": "./dist/cli/bin.js"
  }
}
