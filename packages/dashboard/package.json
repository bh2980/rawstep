{
  "name": "@rawstep/dashboard",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Local Rawstep dashboard UI workspace",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && tsc -p tsconfig.server.json && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "node dist/server/bin.js",
    "start": "node dist/server/bin.js",
    "server": "tsx src/server/bin.ts"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@json-render/core": "0.21.0",
    "@json-render/react": "0.21.0",
    "@json-render/shadcn": "0.21.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "lucide-react": "1.52.0",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.5",
    "@rawstep/core": "workspace:*",
    "@rawstep/policies": "workspace:*",
    "@rawstep/browser": "workspace:*",
    "@rawstep/screenreaders": "workspace:*",
    "@rawstep/reports": "workspace:*"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.19.17",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.2",
    "tsx": "4.21.0",
    "shadcn": "4.21.1"
  },
  "exports": {
    ".": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
