{
  "root": "permissions",
  "elements": {
    "permissions": {
      "type": "Card",
      "props": {
        "title": "$t:permissions.title",
        "description": "$t:permissions.description",
        "maxWidth": "full",
        "centered": false,
        "className": "bg-card/40"
      },
      "children": [
        "actions"
      ]
    },
    "actions": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "lg",
        "align": "stretch",
        "justify": "start",
        "className": null
      },
      "children": [
        "navigation",
        "forward",
        "backward",
        "extraNavigation",
        "activate",
        "divider",
        "input",
        "textEntry",
        "replaceText"
      ]
    },
    "navigation": {
      "type": "Text",
      "props": {
        "text": "$t:permissions.navigation",
        "variant": "muted"
      },
      "children": []
    },
    "divider": {
      "type": "Separator",
      "props": {},
      "children": []
    },
    "input": {
      "type": "Text",
      "props": {
        "text": "$t:permissions.input",
        "variant": "muted"
      },
      "children": []
    },
    "forward": {
      "type": "Checkbox",
      "props": {
        "label": "$t:permissions.keyboard.forward",
        "name": "keyboard-forward",
        "checked": {
          "$bindState": "/keyboard/forward"
        },
        "checks": null,
        "validateOn": "change"
      },
      "children": []
    },
    "backward": {
      "type": "Checkbox",
      "props": {
        "label": "$t:permissions.keyboard.backward",
        "name": "keyboard-backward",
        "checked": {
          "$bindState": "/keyboard/backward"
        },
        "checks": null,
        "validateOn": "change"
      },
      "children": []
    },
    "extraNavigation": {
      "type": "Checkbox",
      "props": {
        "label": "$t:permissions.keyboard.extraNavigation",
        "name": "keyboard-extraNavigation",
        "checked": {
          "$bindState": "/keyboard/extraNavigation"
        },
        "checks": null,
        "validateOn": "change"
      },
      "children": []
    },
    "activate": {
      "type": "Checkbox",
      "props": {
        "label": "$t:permissions.keyboard.activate",
        "name": "keyboard-activate",
        "checked": {
          "$bindState": "/keyboard/activate"
        },
        "checks": null,
        "validateOn": "change"
      },
      "children": []
    },
    "textEntry": {
      "type": "Switch",
      "props": {
        "label": "$t:permissions.textEntry",
        "name": "keyboard-textEntry",
        "checked": {
          "$bindState": "/keyboard/textEntry"
        },
        "checks": null,
        "validateOn": "change"
      },
      "children": []
    },
    "replaceText": {
      "type": "Switch",
      "props": {
        "label": "$t:permissions.replaceText",
        "name": "keyboard-replaceText",
        "checked": {
          "$bindState": "/keyboard/replaceText"
        },
        "checks": null,
        "validateOn": "change"
      },
      "children": []
    }
  }
}
