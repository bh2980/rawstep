{
  "name": "@rawstep/reports",
  "private": true,
  "version": "0.2.0",
  "description": "Rawstep reports workspace",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    "./analyze/llm": {
      "types": "./dist/analyze/llm.d.ts",
      "import": "./dist/analyze/llm.js",
      "default": "./dist/analyze/llm.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./analyze": {
      "types": "./dist/analyze/index.d.ts",
      "import": "./dist/analyze/index.js",
      "default": "./dist/analyze/index.js"
    },
    "./hints": {
      "types": "./dist/hints/index.d.ts",
      "import": "./dist/hints/index.js",
      "default": "./dist/hints/index.js"
    },
    "./report": {
      "types": "./dist/report/index.d.ts",
      "import": "./dist/report/index.js",
      "default": "./dist/report/index.js"
    },
    "./report/summary": {
      "types": "./dist/report/summary.d.ts",
      "import": "./dist/report/summary.js",
      "default": "./dist/report/summary.js"
    },
    "./package.json": "./package.json",
    "./compare": {
      "types": "./dist/compare/index.d.ts",
      "import": "./dist/compare/index.js",
      "default": "./dist/compare/index.js"
    },
    "./endings": {
      "types": "./dist/endings/index.d.ts",
      "import": "./dist/endings/index.js",
      "default": "./dist/endings/index.js"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@rawstep/core": "workspace:*",
    "@rawstep/policies": "workspace:*",
    "zod": "4.6.5"
  }
}
