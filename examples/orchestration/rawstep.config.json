  "runRules": {
    "repetitionGuard": "auto",
    "maxStateVisits": 5,
    "maxUnchangedTransitions": 4,
    "modelGiveUp": false,
    "maxReplans": 4,
    "stepActionLimit": 20,
    "failureLimit": 2,
    "noChangeLimit": 3,
    "taskControl": "rawstep",
    "confidenceFloor": 0.25
