      "id": "codex-plan-guided",
      "name": "Codex 계획(작성 지침) + Jev",
      "structure": "planned",
      "planner": {
        "connectionId": "codex",
        "modelId": "gpt-6.1-sol",
        "reasoningEffort": "low",
        "instructions": "Write tasks the executor can follow without judgement: each moving task names the target item and how to move there (for example \"Move by headings to the Returns heading\", \"Move item by item until you hear Add to cart, button\"), with activates false. Activating is always a task of its own with activates true. When the target is far, prefer jumping by headings or form controls over moving item by item."
      },
      "executors": {
        "screenreader": {
          "connectionId": "jev",
          "modelId": "jev-1.13.0",
          "inputs": [
