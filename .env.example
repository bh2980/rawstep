# Copy to .env.local (git-ignored). Never commit real keys.
# Each provider keeps its key in a fixed variable (a custom server names its own with apiKeyEnv
# in rawstep.config.json). The value goes here or in the process environment.
# The dashboard can write this file for you.
RAWSTEP_OPENAI_API_KEY=
RAWSTEP_ANTHROPIC_API_KEY=
RAWSTEP_GOOGLE_API_KEY=
RAWSTEP_OPENROUTER_API_KEY=
RAWSTEP_TYPESAFE_API_KEY=
RAWSTEP_AI_GATEWAY_API_KEY=
