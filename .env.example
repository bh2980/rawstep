# Copy to .env.local. Never commit real keys. CLI loads files; libraries do not.
RAWSTEP_DECISION_PROVIDER=vercel-evaluation
RAWSTEP_DECISION_BASE_URL=https://ai-gateway.vercel.sh/v1
RAWSTEP_DECISION_API_KEY=
RAWSTEP_DECISION_MODEL=
RAWSTEP_DECISION_INPUTS=text
# Optional OpenRouter experiment key; leaves the saved TypeSafe/Gateway key intact.
# Select --decision-provider openrouter-systemone --decision-base-url https://openrouter.ai/api/v1
# For Clef Flash screenshots: --decision-model cloudflare/clef-flash --decision-inputs text,image
# Images are inline content parts inside state; Jev remains a text-only choice.
RAWSTEP_DECISION_OPENROUTER_API_KEY=
# For a separately running multimodal service:
# RAWSTEP_DECISION_PROVIDER=systemone-http
# RAWSTEP_DECISION_BASE_URL=http://127.0.0.1:8000/v1
# RAWSTEP_DECISION_INPUTS=text,image
# RAWSTEP_DECISION_MODEL must match the model identity returned by that service.
RAWSTEP_ANALYSIS_PROVIDER=openai-compatible
RAWSTEP_ANALYSIS_BASE_URL=http://127.0.0.1:31415/v1
RAWSTEP_ANALYSIS_API_KEY=
RAWSTEP_ANALYSIS_MODEL=auto
