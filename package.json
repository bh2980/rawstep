{
  "name": "rawstep-workspace",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "build": "pnpm -r build",
    "demo:build": "pnpm --filter @rawstep/demo build",
    "demo:dev": "pnpm --filter @rawstep/demo dev",
    "demo:preview": "pnpm --filter @rawstep/demo preview",
    "test": "vitest run",
    "rawstep": "tsx --tsconfig tsconfig.json apps/cli/src/index.ts"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.4",
    "zod": "^4.3.6"
  }
}
